# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Vector Store ───────────────────────────────────────────────────────────
EIGER_QDRANT_HOST=localhost
EIGER_QDRANT_PORT=6333

# ─── LLM Backend (Ollama) ───────────────────────────────────────────────────
# 127.0.0.1 rather than "localhost": some systems resolve "localhost" to the
# IPv6 loopback first, and Ollama may only listen on IPv4 — see
# eiger/llm/ollama.py's DEFAULT_HOST comment.
EIGER_OLLAMA_HOST=127.0.0.1
EIGER_OLLAMA_PORT=11434

# ─── Embedding Model ────────────────────────────────────────────────────────
EIGER_DEFAULT_EMBEDDER=sentence-transformers/all-MiniLM-L6-v2

# ─── Experiment Defaults ────────────────────────────────────────────────────
EIGER_RESULTS_DIR=results/
EIGER_LOG_LEVEL=INFO
EIGER_DEFAULT_SEED=42
