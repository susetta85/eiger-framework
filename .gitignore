# Python
venv/
# Per-machine venvs (see Makefile's VENV_DIR — venv-<hostname>)
venv-*/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
# coverage.py's parallel mode produces .coverage.<host>.<pid>.<rand> files
# (e.g. via COVERAGE_FILE or --parallel-mode); the bare ".coverage" pattern
# above does not match these, and one was previously committed by mistake.
.coverage.*
coverage.xml

# Environment & secrets
.env
*.key
*.pem
authorized_keys

# IDE
.DS_Store
.idea/
.vscode/

# Data & storage
chroma_data/
ollama_data/
qdrant_storage/
results/
# External/large dataset files (raw exports and LLM-enriched output) —
# too large and/or not ours to redistribute via Git. See docs/DATASETS.md
# and scripts/README.md for how each dataset under data/<name>/ is
# produced and where the raw source files live.
data/

# ContainerLab runtime artifacts (never commit these)
clab-*/
